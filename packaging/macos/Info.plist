<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The bundle wrapper for the desktop wallet.

  Written by hand and stamped by `make dist-desktop` rather than generated by a
  packaging tool. There is no CFBundleIconFile: this application ships without
  an icon rather than pulling an image toolchain into a build whose whole
  argument is that it is boring and inspectable.

  There is no code signature either, and that is a decision rather than an
  omission — see docs/INSTALL.md for why an anonymous project cannot hold an
  Apple Developer ID and what it offers instead.
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Zycord Wallet</string>
  <key>CFBundleDisplayName</key>
  <string>Zycord Wallet</string>
  <key>CFBundleExecutable</key>
  <string>zycord-wallet</string>
  <key>CFBundleIdentifier</key>
  <string>org.zycord.wallet</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>LSMinimumSystemVersion</key>
  <string>10.15</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- No network entitlement is claimed and none is needed: the wallet talks
       to a node the operator names, over loopback by default. -->
</dict>
</plist>
